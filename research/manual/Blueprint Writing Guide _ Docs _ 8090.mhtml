roke=3D"currentColor" stroke-width=3D"2" stroke-linecap=3D"round" stroke-li=
nejoin=3D"round" class=3D"lucide lucide-link absolute -left-8 mt-1 h-5 w-5 =
scale-75 opacity-0 transition-all duration-200 group-hover:opacity-60 group=
