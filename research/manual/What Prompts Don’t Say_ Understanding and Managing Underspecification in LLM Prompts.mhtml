<tr id=3D"A3.T3.1.1.1" class=3D"ltx_tr">
<th id=3D"A3.T3.1.1.1.1" class=3D"ltx_td ltx_th ltx_th_row ltx_border_tt"><=
/th>
<th id=3D"A3.T3.1.1.1.2" class=3D"ltx_td ltx_align_center ltx_th ltx_th_col=
umn ltx_border_tt"><span id=3D"A3.T3.1.1.1.2.1" class=3D"ltx_text ltx_font_=
bold">Fill-in Rate</span></th>
</tr>
</thead>
<tbody class=3D"ltx_tbody">
