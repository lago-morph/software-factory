n class=\"pl-cce\"\u003e\\\u0026quot;\u003c/span\u003e   Skill ID: {skill[\u0026#39;skill_id\u0026#39;]}\u003cspan class=\"pl-cce\"\u003e\\\u0026quot;\u003c/span\u003e)\u003cspan class=\"pl-cce\"\u003e\\n\u003c/span\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e,","    \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e        print(f\u003cspan class=\"pl-cce\"\u003e\\\u0026quot;\u003c/span\u003e   Current Version: {skill[\u0026#39;latest_version\u0026#39;]}\u003cspan class=\"pl-cce\"\u003e\\\u0026quot;\u003c/span\u003e)\u003cspan class=\"pl-cce\"\u003e\\n\u003c/span\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e,","    \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e        print(f\u003cspan class=\"pl-cce\"\u003e\\\u0026quot;\u003c/span\u003e   Created: {skill[\u0026#39;created_at\u0026#39;]}\u003cspan class=\"pl-cce\"\u003e\\\u0026quot;\u003c/span\u003e)\u003cspan class=\"pl-cce\"\u003e\\n\u003c/span\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e,","    \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e        if skill.get(\u003cspan class=\"pl-cce\"\u003e\\\u0026quot;\u003c/span\u003eupdated_at\u003cspan class=\"pl-cce\"\u003e\\\u0026quot;\u003c/span\u003e):\u003cspan class=\"pl-cce\"\u003e\\n\u003c/span\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e,","    \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e            print(f\u003cspan class=\"pl-cce\"\u003e\\\u0026quot;\u003c/span\u003e   Last Updated: {skill[\u0026#39;updated_at\u0026#39;]}\u003cspan class=\"pl-cce\"\u003e\\\u0026quot;\u003c/span\u003e)\u003cspan class=\"pl-cce\"\u003e\\n\u003c/span\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e,","    \u003cspan