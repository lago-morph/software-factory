<span class=3D"line"><span style=3D"color:#24292E;--shiki-dark:#E1E4E8">san=
dbox =3D </span><span style=3D"color:#032F62;--shiki-dark:#9ECBFF">"uneleva=
ted"</span><span style=3D"color:#6A737D;--shiki-dark:#6A737D"> # or "elevat=
ed"</span></span>
<span class=3D"line"><span style=3D"color:#6A737D;--shiki-dark:#6A737D"># s=
andbox_private_desktop =3D true  # default; set false only for compatibilit=
y</span></span></code><div class=3D"copy-cnt"><button type=3D"button" class=
